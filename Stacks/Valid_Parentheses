#include<bits/stdc++.h>
using namespace std;
bool validParenthesis(string &s){
     stack<char>st;
	 for(int i = 0; i<s.size(); i++){
		char ch = s[i];
		if(ch == '(' || ch == '{' || ch == '['){
			st.push(ch);
		}
		else{
			if(ch == ')' && !st.empty() && st.top() == '(')
			{
				st.pop();
			}
			else if(ch == '}' && !st.empty() && st.top() == '{')
			{
				st.pop();
			}
			else if(ch == ']' && !st.empty() && st.top() == '[')
			{
				st.pop();
			}
			else{
				return false;
			}
		}
	 }
	 if(st.size() == 0) return true;
	 else return false;
}
int main(){
	string s = "([(])";
	
	bool result = validParenthesis(s);
	if(result){
		cout<<"Valid"<<endl;
	}
	else{
		cout<<"Not Valid"<<endl;
	}

	return 0;
}
